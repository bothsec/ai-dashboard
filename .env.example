# AI Dashboard Server Environment Variables

# Required: At least one of these API keys must be set

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# NVIDIA
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_MODEL=nvidia/llama-3.1-405b-instruct

# Ollama (optional, local AI)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Server settings
PORT=3000
NODE_ENV=production

# User-facing display name injected via system prompt when DISPLAY_MODEL_NAME=false.
# When DISPLAY_MODEL_NAME=false, the model will answer identity questions as itself.
MODEL_DISPLAY_NAME=AI Assistant
DISPLAY_MODEL_NAME=false
